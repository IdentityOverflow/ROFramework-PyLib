{
  "_comment": "WimBrain — 64×64 wave grid, golden anchor layout",
  "_brain_type": "wim_brain.py",

  "name": "Wim-64",
  "brain_path": "brains/Wim-64.npz",
  "log_path":   "brains/logs/Wim-64.csv",
  "world_config": "rulesets/harsher-world.json",

  "grid_size":      128,
